<%# Rupee's banners above every page's content (design §4.1). %>
<% if Current.user&.admin? && Current.family %>
  <% household_settings = Current.family.household_settings %>

  <% unless household_settings.timezone_confirmed? %>
    <div class="mx-auto w-full max-w-2xl mb-4">
      <%= render DS::Alert.new(variant: :warning, title: t("fork.banners.timezone_title")) do %>
        <p><%= t("fork.banners.timezone_body", timezone: Current.family.timezone.presence || t("fork.banners.timezone_unset")) %></p>
        <%= render DS::Link.new(text: t("fork.banners.timezone_action"), href: settings_household_path, variant: :secondary, size: :sm) %>
      <% end %>
    </div>
  <% end %>

  <%# Until an admin has decided on Rupee once, the dashboard invites them to set it up (design §4.12). %>
  <% if household_settings.ai_consented_at.nil? && controller_name == "pages" && action_name == "dashboard" %>
    <div class="mx-auto w-full max-w-2xl mb-4">
      <%= render DS::Alert.new(variant: :info, title: t("fork.banners.ai_setup_title")) do %>
        <p><%= t("fork.banners.ai_setup_body") %></p>
        <%= render DS::Link.new(text: t("fork.banners.ai_setup_action"), href: settings_household_ai_path, variant: :secondary, size: :sm) %>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# Connections that need attention: one banner each, for whoever can act on it (design §4.3). %>
<% if Current.user && Current.family %>
  <% Fork::ConnectionHealth.attention_items(Current.family).select { |item, _| item.manageable_by?(Current.user) }.first(3).each do |item, status| %>
    <div class="mx-auto w-full max-w-2xl mb-4">
      <%= render DS::Alert.new(variant: (status == :new_accounts ? :info : :warning), title: t("fork.banners.connection.#{status}.title", name: item.name)) do %>
        <p><%= t("fork.banners.connection.#{status}.body", name: item.name, date: (l((item.pending_disconnect_at || item.consent_expires_at).to_date, format: :long) if item.pending_disconnect_at || item.consent_expires_at), code: item.item_error_code) %></p>
        <div class="flex flex-wrap gap-2 mt-2">
          <%= render "fork/connections/actions", item: item, status: status %>
          <%= render DS::Link.new(text: t("fork.banners.connection.details"), href: connections_path, variant: :ghost, size: :sm) %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
