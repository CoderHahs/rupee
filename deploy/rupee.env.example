# Copy to rupee.env on the VM, fill in, and `chmod 600 rupee.env`.
# Keep the four keys marked [password manager] there as well: losing the
# encryption keys makes every encrypted column unreadable, in backups too.

# Image built by .github/workflows/publish.yml from a commit on main.
RUPEE_IMAGE=ghcr.io/coderhahs/rupee:sha-<full commit sha>

# The VM's MagicDNS name, e.g. rupee.<tailnet>.ts.net. The Funnel serves the
# same name, so FORK_PUBLIC_HOST is usually empty.
APP_DOMAIN=
FORK_PUBLIC_HOST=

# `bin/rails secret` [password manager]
SECRET_KEY_BASE=
# `bin/rails db:encryption:init` [password manager]
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Only containers on the VM reach Postgres, through its socket.
POSTGRES_PASSWORD=

# Paths the public listener serves; every other path is a 404 there.
# RUPEE_PUBLIC_PATHS=/webhooks/plaid /bills_feed/*

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER=

# Optional. Rupee sends nothing to a model until an admin consents.
OPENAI_ACCESS_TOKEN=
ANTHROPIC_API_KEY=

# restic repository in the backup bucket, e.g. s3:s3.<region>.amazonaws.com/<bucket>/rupee
RESTIC_REPOSITORY=
# [password manager] Without it the backups cannot be read.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
